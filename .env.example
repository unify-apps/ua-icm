# Template for .env.local - copy this file, then paste your real cookies.
#
#   cp .env.example .env.local && chmod 600 .env.local
#
# .env.local is git-ignored and must never be committed. This file is the
# committed template and must never contain a real cookie value.
#
# Parser rules (the scripts read this file with a small regex, not dotenv):
#   - Keys may only contain A-Z and underscore. No digits, no lowercase.
#   - Values must not contain a double quote character.
#   - No trailing comments on a value line. Put comments on their own line.

# --- Orbit (UAT). This is the working environment: safe to edit here. -------
UA_ORBIT_URL="https://orbit.uat.unifyapps.com"
UA_ORBIT_COOKIE=""

# --- Tool (production). Read-only. Leave the cookie blank unless a human -----
# --- has explicitly asked you to read production. ----------------------------
UA_TOOL_URL="https://tool.prod-aps1.unifyapps.com"
UA_TOOL_COOKIE=""

# Which environment the scripts use when --env is not passed: orbit or tool.
UA_DEFAULT_ENV="orbit"

# Optional. If set, scripts/agent.mjs uses this when --workflow is omitted.
UA_WORKFLOW_ID=""
