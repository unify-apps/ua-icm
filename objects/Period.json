    "startDate":      { "type": "date", "required": true, "title": "Start Date" },
    "endDate":        { "type": "date", "required": true, "title": "End Date" },
    "status":         { "type": "string", "required": true, "title": "Status" },
    "parentPeriodId": { "type": "fk:Period", "title": "Parent Period Id" }
  }
