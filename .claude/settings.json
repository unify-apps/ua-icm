{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || exit 0; S=$(node scripts/check-docs.mjs --warn 2>&1 | head -1); jq -n --arg s \"$S\" '{systemMessage: (\"session end \u00b7 \" + $s)}'",
            "timeout": 30,
            "statusMessage": "Checking the docs describe the repo"
          }
        ]
      }
    ]
  }
}
