{
  "name": "ICM | List Rate Tables",
  "note": "Seeds three rate tables that differ in mode and tiering, so each filter has something to EXCLUDE rather than merely something to match. The 15s sleep after seeding is not padding: a burst of writes takes seconds to reach the search index, and 6s was measurably not enough on the rule suites. No platform id is hardcoded; tables are found and cleaned by their KITFIX- rateTableId.",
  "cases": [
    { "name": "pre-clean KITFIX-RT-1", "entityDelete": { "entityType": "RateTable", "filters": { "rateTableId": "KITFIX-RT-1" }, "allowZero": true } },
    { "name": "pre-clean KITFIX-RT-2", "entityDelete": { "entityType": "RateTable", "filters": { "rateTableId": "KITFIX-RT-2" }, "allowZero": true } },
    { "name": "pre-clean KITFIX-RT-3", "entityDelete": { "entityType": "RateTable", "filters": { "rateTableId": "KITFIX-RT-3" }, "allowZero": true } },

    {
      "name": "seed KITFIX-RT-1",
      "entityCreate": {
        "entityType": "RateTable",
        "properties": { "rateTableId": "KITFIX-RT-1", "name": "KITFIX-Alpha marginal", "mode": "Rate", "tiering": "Marginal" }
      }
    },
    {
      "name": "seed KITFIX-RT-2",
      "entityCreate": {
        "entityType": "RateTable",
        "properties": { "rateTableId": "KITFIX-RT-2", "name": "KITFIX-Beta cliff", "mode": "Rate", "tiering": "Cliff" }
      }
    },
    {
      "name": "seed KITFIX-RT-3",
      "entityCreate": {
        "entityType": "RateTable",
        "properties": { "rateTableId": "KITFIX-RT-3", "name": "KITFIX-Gamma pct", "mode": "PctOfTarget", "tiering": "Marginal" }
      }
    },

    { "name": "let the search index catch up with the seeds", "sleepMs": 15000 },

    {
      "name": "OK - a blank search returns the seeded tables with their fields intact",
      "payload": { "search": "KITFIX-", "mode": "", "tiering": "", "limit": "", "offset": "" },
      "checks": [
        { "path": "status", "equals": "OK" },
        { "path": "total", "equals": 3 },
        { "path": "limit", "equals": 50 },
        { "path": "offset", "equals": 0 },
        { "path": "hasMore", "equals": false }
      ]
    },
    {
      "name": "OK - search matches the rateTableId as well as the name",
      "payload": { "search": "KITFIX-RT-2", "mode": "", "tiering": "", "limit": "", "offset": "" },
      "checks": [
        { "path": "status", "equals": "OK" },
        { "path": "total", "equals": 1 },
        { "path": "rateTables.0.rateTableId", "equals": "KITFIX-RT-2" },
        { "path": "rateTables.0.name", "equals": "KITFIX-Beta cliff" },
        { "path": "rateTables.0.mode", "equals": "Rate" },
        { "path": "rateTables.0.tiering", "equals": "Cliff" }
      ]
    },
    {
      "name": "OK - mode narrows server-side, and total reflects it",
      "payload": { "search": "KITFIX-", "mode": "PctOfTarget", "tiering": "", "limit": "", "offset": "" },
      "checks": [
        { "path": "status", "equals": "OK" },
        { "path": "total", "equals": 1 },
        { "path": "rateTables.0.rateTableId", "equals": "KITFIX-RT-3" }
      ]
    },
    {
      "name": "OK - tiering narrows too, and excludes the other two",
      "payload": { "search": "KITFIX-", "mode": "", "tiering": "Cliff", "limit": "", "offset": "" },
      "checks": [
        { "path": "status", "equals": "OK" },
        { "path": "total", "equals": 1 },
        { "path": "rateTables.0.rateTableId", "equals": "KITFIX-RT-2" }
      ]
    },
    {
      "name": "OK - mode and tiering combine as AND, not OR",
      "payload": { "search": "KITFIX-", "mode": "Rate", "tiering": "Marginal", "limit": "", "offset": "" },
      "checks": [
        { "path": "status", "equals": "OK" },
        { "path": "total", "equals": 1 },
        { "path": "rateTables.0.rateTableId", "equals": "KITFIX-RT-1" }
      ]
    },
    {
      "name": "OK - a filter matching nothing is a result, not an error",
      "payload": { "search": "KITFIX-", "mode": "PctOfTarget", "tiering": "Cliff", "limit": "", "offset": "" },
      "checks": [
        { "path": "status", "equals": "OK" },
        { "path": "total", "equals": 0 },
        { "path": "hasMore", "equals": false }
      ]
    },
    {
      "name": "OK - first page of two, hasMore true",
      "payload": { "search": "KITFIX-", "mode": "", "tiering": "", "limit": "2", "offset": "0" },
      "checks": [
        { "path": "status", "equals": "OK" },
        { "path": "total", "equals": 3 },
        { "path": "limit", "equals": 2 },
        { "path": "hasMore", "equals": true }
      ]
    },
    {
      "name": "OK - the last page reports hasMore false",
      "payload": { "search": "KITFIX-", "mode": "", "tiering": "", "limit": "2", "offset": "2" },
      "checks": [
        { "path": "status", "equals": "OK" },
        { "path": "total", "equals": 3 },
        { "path": "offset", "equals": 2 },
        { "path": "hasMore", "equals": false }
      ]
    },
    {
      "name": "OK - limit is clamped to the 200 ceiling rather than trusted",
      "payload": { "search": "KITFIX-", "mode": "", "tiering": "", "limit": "5000", "offset": "" },
      "checks": [
        { "path": "status", "equals": "OK" },
        { "path": "limit", "equals": 200 }
      ]
    },
    {
      "name": "INVALID_INPUT - limit is not a number",
      "payload": { "search": "", "mode": "", "tiering": "", "limit": "ten", "offset": "" },
      "checks": [
        { "path": "status", "equals": "INVALID_INPUT" },
        { "path": "success", "equals": false }
      ]
    },
    {
      "name": "INVALID_INPUT - offset is not a number",
      "payload": { "search": "", "mode": "", "tiering": "", "limit": "", "offset": "-2" },
      "checks": [
        { "path": "status", "equals": "INVALID_INPUT" },
        { "path": "success", "equals": false }
      ]
    },

    { "name": "clean up KITFIX-RT-1", "entityDelete": { "entityType": "RateTable", "filters": { "rateTableId": "KITFIX-RT-1" } } },
    { "name": "clean up KITFIX-RT-2", "entityDelete": { "entityType": "RateTable", "filters": { "rateTableId": "KITFIX-RT-2" } } },
    { "name": "clean up KITFIX-RT-3", "entityDelete": { "entityType": "RateTable", "filters": { "rateTableId": "KITFIX-RT-3" } } }
  ]
}
