  {
   "name": "FETCH_TRUNCATED - a page too small to hold the data refuses instead of averaging a prefix",
   "payload": {
    "periodId": "e_6aa001b735cc1f4f3c704dae",
    "dryRun": true,
    "pageLimit": 1
   },
   "checks": [
    {
     "path": "status",
     "equals": "FETCH_TRUNCATED"
