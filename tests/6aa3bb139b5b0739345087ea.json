      "entityFind": {
        "entityType": "Currency",
        "filters": {
          "code": "USD"
        }
      }
    },
    {
      "name": "pre-cleanup: assignments named KITTEST-UPDPOS Seat",
      "entityDelete": {
        "entityType": "PayeePositionAssignment",
        "filters": {
          "name": "KITTEST-UPDPOS Seat assignment"
        },
        "allowZero": true
      }
    },
    {
      "name": "pre-cleanup: title rows named KITTEST-UPDPOS Seat",
      "entityDelete": {
        "entityType": "PositionAttribute",
        "filters": {
          "name": "KITTEST-UPDPOS Seat attributes"
        },
        "allowZero": true
      }
    },
    {
