{
  "name": "ICM | List Credit Rules",
  "note": "Seeds four rules - three of this stage, one of the other - so 'the other stage never leaks in' is testable. Every filter case pins itself to the seeds with an ICONTAINS 'KITFIX-' leaf and asserts a COMPLEMENT: EQUAL gives 1 of 3 and NOT_EQUAL the other 2. That is deliberate. Asserting against an assumed table size is what once made every negative operator look broken - there were leftover rules nobody counted, so the correct complement read as 'the filter was ignored', and the refusals built on that reading were wrong.",
  "cases": [
    {
      "name": "pre-clean KITFIX-CR-1",
      "entityDelete": {
        "entityType": "Rule",
        "filters": {
          "ruleId": "KITFIX-CR-1"
        },
        "allowZero": true
      },
      "checks": []
    },
    {
      "name": "pre-clean KITFIX-CR-2",
      "entityDelete": {
        "entityType": "Rule",
        "filters": {
          "ruleId": "KITFIX-CR-2"
        },
        "allowZero": true
      },
      "checks": []
    },
    {
      "name": "pre-clean KITFIX-CR-3",
      "entityDelete": {
        "entityType": "Rule",
        "filters": {
          "ruleId": "KITFIX-CR-3"
        },
        "allowZero": true
      },
      "checks": []
    },
    {
      "name": "pre-clean KITFIX-PR-X",
      "entityDelete": {
        "entityType": "Rule",
        "filters": {
          "ruleId": "KITFIX-PR-X"
        },
        "allowZero": true
      },
      "checks": []
    },
    {
      "name": "seed KITFIX-CR-1",
      "entityCreate": {
        "entityType": "Rule",
        "properties": {
          "ruleId": "KITFIX-CR-1",
          "stage": "credit",
          "name": "KITFIX-Alpha credit",
          "ruleType": "Direct Credit",
          "tags": "kitfix",
          "conditions": {
            "items": [
              {
                "connector": "If",
                "subject": "Transaction",
                "value": "x"
              }
            ]
          },
          "result": {
            "name": "R1"
          }
        }
      },
      "checks": []
    },
    {
      "name": "seed KITFIX-CR-2",
      "entityCreate": {
        "entityType": "Rule",
        "properties": {
          "ruleId": "KITFIX-CR-2",
          "stage": "credit",
          "name": "KITFIX-Beta credit",
          "ruleType": "Direct Credit",
          "tags": "kitfix",
          "conditions": {
            "items": [
              {
                "connector": "If",
                "subject": "Transaction",
                "value": "x"
              }
            ]
          },
          "result": {
            "name": "R1"
          }
        }
      },
      "checks": []
    },
    {
      "name": "seed KITFIX-CR-3",
      "entityCreate": {
        "entityType": "Rule",
        "properties": {
          "ruleId": "KITFIX-CR-3",
          "stage": "credit",
          "name": "KITFIX-Gamma credit",
          "ruleType": "Direct Credit",
          "tags": "kitfix",
          "conditions": {
            "items": [
              {
                "connector": "If",
                "subject": "Transaction",
                "value": "x"
              }
            ]
          },
          "result": {
            "name": "R1"
          }
        }
      },
      "checks": []
    },
    {
      "name": "seed KITFIX-PR-X",
      "entityCreate": {
        "entityType": "Rule",
        "properties": {
          "ruleId": "KITFIX-PR-X",
          "stage": "payout",
          "name": "KITFIX-Alpha payout",
          "ruleType": "Commission",
          "tags": "kitfix",
          "conditions": {
            "items": [
              {
                "connector": "If",
                "subject": "Transaction",
                "value": "x"
              }
            ]
          },
          "result": {
            "name": "R1"
          }
        }
      },
      "checks": []
    },
    {
      "name": "let the search index catch up with the seeds",
      "sleepMs": 15000,
      "checks": []
    },
    {
      "name": "FILTER EQUAL - exact name",
      "payload": {
        "search": "",
        "name": "",
        "ruleType": "",
        "limit": "50",
        "offset": "0",
        "filter": {
          "op": "AND",
          "values": [
            {
              "field": "name",
              "op": "ICONTAINS",
              "values": [
                "KITFIX-"
              ]
            },
            {
              "field": "name",
              "op": "EQUAL",
              "values": [
                "KITFIX-Alpha credit"
              ]
            }
          ]
        }
      },
      "checks": [
        {
          "path": "status",
          "equals": "OK"
        },
        {
          "path": "total",
          "equals": 1
        }
      ]
    },
    {
      "name": "FILTER NOT_EQUAL - the complement, within the same seeded set",
      "payload": {
        "search": "",
        "name": "",
        "ruleType": "",
        "limit": "50",
        "offset": "0",
        "filter": {
          "op": "AND",
          "values": [
            {
              "field": "name",
              "op": "ICONTAINS",
              "values": [
                "KITFIX-"
              ]
            },
            {
              "field": "name",
              "op": "NOT_EQUAL",
              "values": [
                "KITFIX-Alpha credit"
              ]
            }
          ]
        }
      },
      "checks": [
        {
          "path": "status",
          "equals": "OK"
        },
        {
          "path": "total",
          "equals": 2
        }
      ]
    },
    {
      "name": "FILTER ICONTAINS - case-insensitive substring",
      "payload": {
        "search": "",
        "name": "",
        "ruleType": "",
        "limit": "50",
        "offset": "0",
        "filter": {
          "op": "AND",
          "values": [
            {
              "field": "name",
              "op": "ICONTAINS",
              "values": [
                "KITFIX-"
              ]
            },
            {
              "field": "name",
              "op": "ICONTAINS",
              "values": [
                "alpha"
              ]
            }
          ]
        }
      },
      "checks": [
        {
          "path": "status",
          "equals": "OK"
        },
        {
          "path": "total",
          "equals": 1
        }
      ]
    },
    {
      "name": "FILTER NOT_ICONTAINS - its complement",
      "payload": {
        "search": "",
        "name": "",
        "ruleType": "",
        "limit": "50",
        "offset": "0",
        "filter": {
          "op": "AND",
          "values": [
            {
              "field": "name",
              "op": "ICONTAINS",
              "values": [
                "KITFIX-"
              ]
            },
            {
              "field": "name",
              "op": "NOT_ICONTAINS",
              "values": [
                "alpha"
              ]
            }
          ]
        }
      },
      "checks": [
        {
          "path": "status",
          "equals": "OK"
        },
        {
          "path": "total",
          "equals": 2
        }
      ]
    },
    {
      "name": "FILTER OR group - either of two names",
      "payload": {
        "search": "",
        "name": "",
        "ruleType": "",
        "limit": "50",
        "offset": "0",
        "filter": {
          "op": "OR",
          "values": [
            {
              "field": "name",
              "op": "EQUAL",
              "values": [
                "KITFIX-Alpha credit"
              ]
            },
            {
              "field": "name",
              "op": "EQUAL",
              "values": [
                "KITFIX-Beta credit"
              ]
            }
          ]
        }
      },
      "checks": [
        {
          "path": "status",
          "equals": "OK"
        },
        {
          "path": "total",
          "equals": 2
        }
      ]
    },
    {
      "name": "FILTER - the stage identity still wins over the caller's filter",
      "payload": {
        "search": "",
        "name": "",
        "ruleType": "",
        "limit": "50",
        "offset": "0",
        "filter": {
          "op": "AND",
          "values": [
            {
              "field": "name",
              "op": "ICONTAINS",
              "values": [
                "KITFIX-"
              ]
            }
          ]
        }
      },
      "checks": [
        {
          "path": "status",
          "equals": "OK"
        },
        {
          "path": "total",
          "equals": 3
        },
        {
          "path": "rules.0.stage",
          "equals": "credit"
        }
      ]
    },
    {
      "name": "INVALID_INPUT - an unfilterable field is refused, not ignored",
      "payload": {
        "search": "",
        "name": "",
        "ruleType": "",
        "limit": "50",
        "offset": "0",
        "filter": {
          "op": "AND",
          "values": [
            {
              "field": "secretSalary",
              "op": "EQUAL",
              "values": [
                "1"
              ]
            }
          ]
        }
      },
      "checks": [
        {
          "path": "status",
          "equals": "INVALID_INPUT"
        }
      ]
    },
    {
      "name": "INVALID_INPUT - an unsupported operator is refused",
      "payload": {
        "search": "",
        "name": "",
        "ruleType": "",
        "limit": "50",
        "offset": "0",
        "filter": {
          "op": "AND",
          "values": [
            {
              "field": "name",
              "op": "REGEX",
              "values": [
                ".*"
              ]
            }
          ]
        }
      },
      "checks": [
        {
          "path": "status",
          "equals": "INVALID_INPUT"
        }
      ]
    },
    {
      "name": "clean up KITFIX-CR-1",
      "entityDelete": {
        "entityType": "Rule",
        "filters": {
          "ruleId": "KITFIX-CR-1"
        }
      },
      "checks": []
    },
    {
      "name": "clean up KITFIX-CR-2",
      "entityDelete": {
        "entityType": "Rule",
        "filters": {
          "ruleId": "KITFIX-CR-2"
        }
      },
      "checks": []
    },
    {
      "name": "clean up KITFIX-CR-3",
      "entityDelete": {
        "entityType": "Rule",
        "filters": {
          "ruleId": "KITFIX-CR-3"
        }
      },
      "checks": []
    },
    {
      "name": "clean up KITFIX-PR-X",
      "entityDelete": {
        "entityType": "Rule",
        "filters": {
          "ruleId": "KITFIX-PR-X"
        }
      },
      "checks": []
    }
  ]
}
