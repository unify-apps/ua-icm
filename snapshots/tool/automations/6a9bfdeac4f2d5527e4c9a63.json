        "compile_static": false,
        "code": "\n// Every default applied HERE. Callers send \"\" for what they did not fill, so \"\"\n// is what each branch is built around rather than an edge case.\ndef t = { v -> v == null ? '' : v.toString().trim() }\ndef code = t(positionCode); def nm = t(name)\ndef tid = t(titleId); def pid = t(payeeId); def raw = t(effectiveStart)\n\nboolean valid = true; String reason = ''\nlong epoch = 0L\nif (code.isEmpty())      { valid = false; reason = 'positionCode is required' }\nelse if (nm.isEmpty())   { valid = false; reason = 'name is required' }\nelse if (tid.isEmpty())  { valid = false; reason = 'titleId is required' }\n\nif (valid) {\n    if (raw.isEmpty()) {\n        // default: TODAY, UTC - echoed back so a caller elsewhere knows which day it got\n        def dd = java.time.LocalDate.now(java.time.ZoneOffset.UTC)\n        epoch = dd.atStartOfDay(java.time.ZoneOffset.UTC).toInstant().toEpochMilli()\n    } else if (raw ==~ /^\\d{4}-\\d{2}-\\d{2}$/) {\n        try {\n            def dd = java.time.LocalDate.parse(raw)\n            epoch = dd.atStartOfDay(java.time.ZoneOffset.UTC).toInstant().toEpochMilli()\n        } catch (Exception e) { valid = false; reason = 'effectiveStart is not a real calendar date: ' + raw }\n    } else if (raw ==~ /^\\d{9,}$/) { epoch = Long.parseLong(raw) }\n    else { valid = false; reason = 'effectiveStart must be YYYY-MM-DD or epoch milliseconds, got: ' + raw }\n}\n\n// '__none__' keeps a blank lookup a clean no-match instead of an unfiltered scan\ndef one = { p, v -> [operator:'AND', filters:[[property:p, filter:[operator:'EQUAL', value: (v == null || v.isEmpty()) ? '__none__' : v]]]] }\nreturn [valid: valid, reason: reason, code: code, nm: nm, titleId: tid, payeeId: pid,\n        epoch: epoch, wantAssign: !pid.isEmpty(),\n        dupFilter: one('properties.positionCode', code),\n        titleFilter: one('id', tid),\n        payeeFilter: one('id', pid)]",
        "captureStdOutput": false,
