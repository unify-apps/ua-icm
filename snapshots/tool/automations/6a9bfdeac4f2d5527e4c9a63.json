        "compile_static": false,
        "code": "\n// Ordered deliberately: a duplicate code is the caller's most likely mistake and\n// naming it first is more useful than reporting whichever lookup happened to fail.\nint dup = (dupTotal == null) ? 0 : Integer.valueOf(String.valueOf(dupTotal))\nint ttl = (titleTotal == null) ? 0 : Integer.valueOf(String.valueOf(titleTotal))\nint pay = (payeeTotal == null) ? 0 : Integer.valueOf(String.valueOf(payeeTotal))\nboolean ok = true; String status = 'OK'; String message = ''\nif (dup > 0)                    { ok=false; status='DUPLICATE_CODE';   message='A position with code ' + code + ' already exists' }\nelse if (ttl == 0)              { ok=false; status='TITLE_NOT_FOUND';  message='No title with id ' + titleId }\nelse if (wantAssign && pay == 0){ ok=false; status='PAYEE_NOT_FOUND';  message='No payee with id ' + payeeId }\nreturn [ok: ok, status: status, message: message]",
        "captureStdOutput": false,
