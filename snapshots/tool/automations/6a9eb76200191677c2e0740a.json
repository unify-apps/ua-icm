        "compile_static": false,
        "code": "\nimport groovy.json.JsonSlurper\n// \"\" is what real callers send for anything they left blank.\ndef opt = { String k -> if (!binding.hasVariable(k)) return ''\n                        def v = binding.getVariable(k); return (v == null) ? '' : v.toString().trim() }\ndef nm = opt('name'); def rt = opt('ruleType')\ndef desc = opt('description'); def tg = opt('tags')\ndef condRaw = opt('conditionsJson'); def resRaw = opt('resultsJson')\ndef extra = opt('multiplier')\n\nboolean valid = true; String reason = ''\nif (nm.isEmpty()) { valid = false; reason = 'name is required' }\nelse if (rt.isEmpty()) { valid = false; reason = 'ruleType is required' }\n\ndef parse = { String raw, String what ->\n    if (raw.isEmpty()) return []\n    try { def p = new JsonSlurper().parseText(raw); return (p instanceof List) ? p : [] }\n    catch (Exception e) { valid = false; reason = what + ' is not valid JSON'; return [] }\n}\ndef conds = parse(condRaw, 'conditionsJson')\ndef results = parse(resRaw, 'resultsJson')\n\n// A rule that produces nothing would match deals and change no numbers, which is\n// a rule nobody can see the effect of. Refuse it rather than store it.\nif (valid && results.isEmpty()) { valid = false; reason = 'a rule needs at least one result' }\nif (valid) results.eachWithIndex { r, i ->\n    if (valid && (r?.name == null || r.name.toString().trim().isEmpty()))\n        { valid = false; reason = 'result ' + (i + 1) + ' has no name' }\n}\n\n// Dates: same rule as every other ICM callable - '' means unset, not today,\n// because a rule with no window is in force for all time.\ndef toEpoch = { String raw, String what ->\n    if (raw.isEmpty()) return null\n    if (raw ==~ /^\\d{4}-\\d{2}-\\d{2}$/) {\n        try { return java.time.LocalDate.parse(raw).atStartOfDay(java.time.ZoneOffset.UTC).toInstant().toEpochMilli() }\n        catch (Exception e) { valid = false; reason = what + ' is not a real calendar date: ' + raw; return null }\n    }\n    if (raw ==~ /^\\d{9,}$/) return Long.parseLong(raw)\n    valid = false; reason = what + ' must be YYYY-MM-DD or epoch milliseconds, got: ' + raw; return null\n}\ndef sEp = toEpoch(opt('activeStart'), 'activeStart')\ndef eEp = toEpoch(opt('activeEnd'), 'activeEnd')\nif (valid && sEp != null && eEp != null && eEp < sEp) { valid = false; reason = 'activeEnd is before activeStart' }\n\n// The id is MINTED here, not asked for: the form has no field for it and a\n// human-picked key on a rule buys nothing, unlike a position code.\ndef rid = 'PR-' + System.currentTimeMillis() + '-' + new Random().nextInt(9000).plus(1000)\n\n// A BARE ARRAY in a json property is silently dropped by this platform - it\n// saves with a 200 and reads back {}. Everything ordered goes in under 'items'.\nreturn [valid: valid, reason: reason, ruleId: rid, nm: nm, rt: rt, desc: desc, tg: tg, extra: extra,\n        activeStart: sEp, activeEnd: eEp,\n        conditions: [items: conds], results: [items: results],\n        conditionCount: conds.size(), resultCount: results.size(),\n        dupFilter: [operator:'AND', filters:[[property:'properties.ruleId', filter:[operator:'EQUAL', value: rid]]]]]",
        "captureStdOutput": false,
