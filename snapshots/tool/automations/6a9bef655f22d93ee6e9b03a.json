        "code": "// Defaults are applied HERE. Real callers send \"\" for what they did not fill,\n// so \"\" is the value every branch is built around, not an edge case.\ndef t = { v -> v == null ? '' : v.toString().trim() }\n// `filter` arrived after this callable was already live, and the original data source\n// does not send it. An unbound parameter is a MISSING Groovy variable, not a null one,\n// so it has to be asked for by name or the old caller dies with \"No such property\".\ndef rawFilter = binding.hasVariable('filter') ? binding.getVariable('filter') : null\ndef act  = t(action).toUpperCase()\nif (act.isEmpty()) act = 'LIST'\ndef id   = t(titleId)\ndef code = t(titleCode)\ndef nm   = t(name)\ndef s    = t(search)\ndef lim  = t(limit)\ndef off  = t(offset)\n\nboolean valid = true\nString reason = ''\n\nif (!(act in ['LIST', 'CREATE', 'UPDATE'])) {\n    valid = false; reason = 'action must be LIST, CREATE or UPDATE, got: ' + act\n} else if (act == 'CREATE') {\n    // titleCode is the object's unique key and name is required on the schema.\n    if (code.isEmpty()) { valid = false; reason = 'titleCode is required to create a title' }\n    else if (nm.isEmpty()) { valid = false; reason = 'name is required to create a title' }\n} else if (act == 'UPDATE' && id.isEmpty()) {\n    valid = false; reason = 'titleId is required to update a title'\n}\n\nint pageLimit = 50\nif (!lim.isEmpty()) {\n    if (lim ==~ /^\\d+$/) { pageLimit = Integer.parseInt(lim) } else { valid = false; reason = 'limit must be a whole number, got: ' + lim }\n}\nif (pageLimit < 1) pageLimit = 1\nif (pageLimit > 200) pageLimit = 200\n\nint pageOffset = 0\nif (!off.isEmpty()) {\n    if (off ==~ /^\\d+$/) { pageOffset = Integer.parseInt(off) } else { valid = false; reason = 'offset must be a whole number, got: ' + off }\n}\n\n// LIST search: a nested OR inside the AND, built here and passed as ONE pill.\n// A node's static config cannot express this; the runtime accepts it.\n// ---- the filter block -------------------------------------------------------\n// The screen sends the platform's own wire shape - {op, values:[{field, op, values}]},\n// groups nested by the same rule - and the storage node speaks a DIFFERENT dialect:\n// {operator, filters:[{property, filter:{operator, value}}]}. Translating between the\n// two is this section's whole job. Sending the wire shape straight through answers\n// HTTP 500 \"Filter$Op ... op is null\" at RUN time, which names no node.\n//\n// Only the operators the screen can actually offer are accepted (platform-filter.ts,\n// TEXT_OPERATORS). Every one of them takes exactly one value or none, which is why\n// there is no list-valued case here - if NUMBER or DATE fields are ever added to the\n// screen, BETWEEN arrives with two and this must grow a branch for it.\ndef FILTER_FIELDS = ['titleCode', 'name', 'description', 'category', 'level', 'market', 'function', 'payPeriod'] as Set\ndef ONE_VALUE_OPS = ['EQUAL', 'NOT_EQUAL', 'ICONTAINS', 'NOT_ICONTAINS', 'CONTAINS', 'NOT_CONTAINS',\n                     'STARTS_WITH', 'NOT_STARTS_WITH', 'ENDS_WITH', 'NOT_ENDS_WITH', 'REGEX', 'NOT_REGEX'] as Set\ndef NO_VALUE_OPS = ['EXISTS', 'MISSING'] as Set\ndef GROUP_OPS = ['AND', 'OR'] as Set\n\n// Collected, not thrown at the first one: a caller fixing three mistakes one refusal at\n// a time is the experience this avoids.\ndef filterProblems = []\n\ndef parsed = rawFilter\nif (parsed instanceof String) {\n    def raw = parsed.trim()\n    if (raw.isEmpty()) parsed = null\n    else {\n        try { parsed = new groovy.json.JsonSlurper().parseText(raw) }\n        catch (Exception e) { filterProblems << ('filter is not valid JSON: ' + e.getMessage()); parsed = null }\n    }\n}\nif (parsed instanceof Map && parsed.isEmpty()) parsed = null\n\ndef toStorage\ntoStorage = { node, String path ->\n    if (!(node instanceof Map)) { filterProblems << (path + ': a filter node must be an object'); return null }\n    def op = (node.op == null) ? '' : String.valueOf(node.op).trim().toUpperCase()\n    def field = (node.field == null) ? '' : String.valueOf(node.field).trim()\n\n    // No field means a GROUP. The wire shape carries a group's children in `values`, the\n    // same key a leaf uses for its operands - the presence of `field` is the only thing\n    // that tells them apart.\n    if (field.isEmpty()) {\n        if (!GROUP_OPS.contains(op)) { filterProblems << (path + ': a group needs op AND or OR, got \"' + op + '\"'); return null }\n        def kids = []\n        def vals = node.values\n        if (vals != null && !(vals instanceof List)) { filterProblems << (path + ': values of a group must be a list'); return null }\n        (vals ?: []).eachWithIndex { child, i ->\n            def c = toStorage(child, path + '.values[' + i + ']')\n            if (c != null) kids << c\n        }\n        // An empty group is not an error - it is a filter the user started and did not\n        // finish. Dropping it means \"no filter\", which is what the screen shows anyway.\n        if (kids.isEmpty()) return null\n        return [operator: op, filters: kids]\n    }\n\n    if (!FILTER_FIELDS.contains(field)) { filterProblems << (path + ': unknown field \"' + field + '\"'); return null }\n    boolean takesValue = ONE_VALUE_OPS.contains(op)\n    if (!takesValue && !NO_VALUE_OPS.contains(op)) { filterProblems << (path + ': operator \"' + op + '\" is not supported for ' + field); return null }\n\n    def leaf = [operator: op]\n    if (takesValue) {\n        def vals = (node.values instanceof List) ? node.values : (node.values == null ? [] : [node.values])\n        def first = vals.findResult { (it == null) ? null : (String.valueOf(it).trim() ?: null) }\n        if (first == null) { filterProblems << (path + ': ' + op + ' needs one value'); return null }\n        if (op == 'REGEX' || op == 'NOT_REGEX') {\n            try { java.util.regex.Pattern.compile(first) }\n            catch (Exception e) { filterProblems << (path + ': not a valid regular expression: ' + first); return null }\n        }\n        leaf.value = first\n    }\n    return [property: 'properties.' + field, filter: leaf]\n}\n\ndef filterNode = (parsed == null) ? null : toStorage(parsed, 'filter')\nif (!filterProblems.isEmpty()) {\n    valid = false\n    reason = (reason.isEmpty() ? '' : reason + '; ') + filterProblems.join('; ')\n}\n\ndef lf = []\nif (!valid) {\n    lf << [property: 'id', filter: [operator: 'EQUAL', value: '__invalid_input__']]\n} else {\n    // Search and filter are ANDed: the box narrows whatever the block already selected,\n    // which is what a user typing into it while a filter is set expects.\n    if (!s.isEmpty()) {\n        lf << [operator: 'OR', filters: [\n            [property: 'properties.titleCode',   filter: [operator: 'ICONTAINS', value: s]],\n            [property: 'properties.name',        filter: [operator: 'ICONTAINS', value: s]],\n            [property: 'properties.description', filter: [operator: 'ICONTAINS', value: s]]]]\n    }\n    if (filterNode != null) lf << filterNode\n}\n\n// The unique-key pre-check. A unique hit at WRITE time is a raw Mongo E11000\n// that kills the run - it is never save-time visible, so it is checked first.\ndef df = (valid && act != 'LIST' && !code.isEmpty())\n    ? [[property: 'properties.titleCode', filter: [operator: 'EQUAL', value: code]]]\n    : [[property: 'id', filter: [operator: 'EQUAL', value: '__none__']]]\n\n// The UPDATE target, read back so a missing id is NOT_FOUND rather than an engine error.\ndef of = (valid && act == 'UPDATE')\n    ? [[property: 'id', filter: [operator: 'EQUAL', value: id]]]\n    : [[property: 'id', filter: [operator: 'EQUAL', value: '__none__']]]\n\nreturn [valid: valid, reason: reason, action: act, titleId: id, titleCode: code,\n        pageLimit: pageLimit, pageOffset: pageOffset,\n        listFilter: [operator: 'AND', filters: lf],\n        dupFilter:  [operator: 'AND', filters: df],\n        oneFilter:  [operator: 'AND', filters: of]]\n",
        "compile_static": false,
