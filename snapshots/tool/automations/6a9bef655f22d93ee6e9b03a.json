        "code": "def t = { v -> v == null ? '' : v.toString().trim() }\ndef act  = t(action).toUpperCase()\nif (act.isEmpty()) act = 'LIST'\ndef id   = t(titleId)\ndef code = t(titleCode)\n\n// DUPLICATE: any OTHER record already carries this titleCode. On UPDATE the\n// record's own row is not a clash with itself.\nboolean isDup = false\nif (dupRows != null) dupRows.each { r -> if (String.valueOf(r.id) != id) isDup = true }\n\n// NOT_FOUND: an UPDATE whose target no longer exists.\nboolean notFound = (act == 'UPDATE') && (oneRows == null || oneRows.isEmpty())\n\ndef cur = (oneRows != null && !oneRows.isEmpty() && oneRows[0].properties != null) ? oneRows[0].properties : [:]\ndef curV = { k -> cur[k] == null ? '' : cur[k].toString() }\n\n// On UPDATE the caller is a form that posts every field, so an OPTIONAL field\n// arriving blank means \"clear it\". The two REQUIRED fields fall back to what is\n// already stored, so a partial payload can never blank out the unique key.\ndef rec = [:]\nif (act == 'CREATE') {\n    rec = [titleCode: code, name: t(name), description: t(description), category: t(category),\n           level: t(level), market: t(market), function: t(functionName), payPeriod: t(payPeriod)]\n} else {\n    rec = [titleCode: code.isEmpty() ? curV('titleCode') : code,\n           name: t(name).isEmpty() ? curV('name') : t(name),\n           description: t(description), category: t(category), level: t(level),\n           market: t(market), function: t(functionName), payPeriod: t(payPeriod)]\n}\nreturn [isDup: isDup, notFound: notFound, record: rec,\n        dupMessage: 'A title with code \"' + code + '\" already exists.',\n        nfMessage: 'No title with id \"' + id + '\" exists.']",
