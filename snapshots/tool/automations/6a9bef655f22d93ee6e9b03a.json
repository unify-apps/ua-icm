        "code": "// Defaults are applied HERE. Real callers send \"\" for what they did not fill,\n// so \"\" is the value every branch is built around, not an edge case.\ndef t = { v -> v == null ? '' : v.toString().trim() }\ndef act  = t(action).toUpperCase()\nif (act.isEmpty()) act = 'LIST'\ndef id   = t(titleId)\ndef code = t(titleCode)\ndef nm   = t(name)\ndef s    = t(search)\ndef lim  = t(limit)\ndef off  = t(offset)\n\nboolean valid = true\nString reason = ''\n\nif (!(act in ['LIST', 'CREATE', 'UPDATE'])) {\n    valid = false; reason = 'action must be LIST, CREATE or UPDATE, got: ' + act\n} else if (act == 'CREATE') {\n    // titleCode is the object's unique key and name is required on the schema.\n    if (code.isEmpty()) { valid = false; reason = 'titleCode is required to create a title' }\n    else if (nm.isEmpty()) { valid = false; reason = 'name is required to create a title' }\n} else if (act == 'UPDATE' && id.isEmpty()) {\n    valid = false; reason = 'titleId is required to update a title'\n}\n\nint pageLimit = 50\nif (!lim.isEmpty()) {\n    if (lim ==~ /^\\d+$/) { pageLimit = Integer.parseInt(lim) } else { valid = false; reason = 'limit must be a whole number, got: ' + lim }\n}\nif (pageLimit < 1) pageLimit = 1\nif (pageLimit > 200) pageLimit = 200\n\nint pageOffset = 0\nif (!off.isEmpty()) {\n    if (off ==~ /^\\d+$/) { pageOffset = Integer.parseInt(off) } else { valid = false; reason = 'offset must be a whole number, got: ' + off }\n}\n\n// LIST search: a nested OR inside the AND, built here and passed as ONE pill.\n// A node's static config cannot express this; the runtime accepts it.\ndef lf = []\nif (!valid) {\n    lf << [property: 'id', filter: [operator: 'EQUAL', value: '__invalid_input__']]\n} else if (!s.isEmpty()) {\n    lf << [operator: 'OR', filters: [\n        [property: 'properties.titleCode',   filter: [operator: 'ICONTAINS', value: s]],\n        [property: 'properties.name',        filter: [operator: 'ICONTAINS', value: s]],\n        [property: 'properties.description', filter: [operator: 'ICONTAINS', value: s]]]]\n}\n\n// The unique-key pre-check. A unique hit at WRITE time is a raw Mongo E11000\n// that kills the run - it is never save-time visible, so it is checked first.\ndef df = (valid && act != 'LIST' && !code.isEmpty())\n    ? [[property: 'properties.titleCode', filter: [operator: 'EQUAL', value: code]]]\n    : [[property: 'id', filter: [operator: 'EQUAL', value: '__none__']]]\n\n// The UPDATE target, read back so a missing id is NOT_FOUND rather than an engine error.\ndef of = (valid && act == 'UPDATE')\n    ? [[property: 'id', filter: [operator: 'EQUAL', value: id]]]\n    : [[property: 'id', filter: [operator: 'EQUAL', value: '__none__']]]\n\nreturn [valid: valid, reason: reason, action: act, titleId: id, titleCode: code,\n        pageLimit: pageLimit, pageOffset: pageOffset,\n        listFilter: [operator: 'AND', filters: lf],\n        dupFilter:  [operator: 'AND', filters: df],\n        oneFilter:  [operator: 'AND', filters: of]]",
        "compile_static": false,
        "captureStdOutput": false,
