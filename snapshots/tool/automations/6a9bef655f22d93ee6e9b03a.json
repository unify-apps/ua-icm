        "code": "// Flatten properties into the row shape the contract promises. A field never\n// set on a record is MISSING, not null - it is defaulted to '' so the UI never\n// renders \"null\".\ndef out = []\ndef v = { m, k -> (m != null && m[k] != null) ? m[k].toString() : '' }\nif (rows != null) rows.each { r ->\n    def p = r.properties\n    out << [titleId: String.valueOf(r.id), titleCode: v(p, 'titleCode'), name: v(p, 'name'),\n            description: v(p, 'description'), category: v(p, 'category'), level: v(p, 'level'),\n            market: v(p, 'market'), function: v(p, 'function'), payPeriod: v(p, 'payPeriod')]\n}\nint tot = (total == null) ? out.size() : (total as int)\nreturn [titles: out, total: tot, hasMore: (pageOffset + out.size()) < tot,\n        message: out.isEmpty() ? 'No titles matched.' : (out.size() + ' title(s).')]",
