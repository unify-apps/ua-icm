        "compile_static": false,
        "code": "\ndef opt = { String k -> if (!binding.hasVariable(k)) return ''\n                        def v = binding.getVariable(k); return (v == null) ? '' : v.toString().trim() }\ndef s = opt('search'); def mid = opt('measureId'); def pid = opt('positionId')\ndef lim = opt('limit'); def off = opt('offset')\n\nboolean valid = true; String reason = ''\nint pageLimit = 50\nif (!lim.isEmpty()) { if (lim ==~ /^\\d+$/) pageLimit = Integer.parseInt(lim) else { valid=false; reason='limit must be a whole number, got: ' + lim } }\nif (pageLimit < 1) pageLimit = 1\nif (pageLimit > 200) pageLimit = 200\nint pageOffset = 0\nif (!off.isEmpty()) { if (off ==~ /^\\d+$/) pageOffset = Integer.parseInt(off) else { valid=false; reason='offset must be a whole number, got: ' + off } }\n\ndef leaves = []\nif (!s.isEmpty()) leaves << [property:'properties.quotaId', filter:[operator:'ICONTAINS', value:s]]\nif (!mid.isEmpty()) leaves << [property:'properties.measureId',  filter:[operator:'EQUAL', value:mid]]\nif (!pid.isEmpty()) leaves << [property:'properties.positionId', filter:[operator:'EQUAL', value:pid]]\nif (!valid) leaves = [[property:'id', filter:[operator:'EQUAL', value:'__invalid_input__']]]\nreturn [valid: valid, reason: reason, filter: [operator:'AND', filters: leaves],\n        pageLimit: pageLimit, pageOffset: pageOffset]\n",
