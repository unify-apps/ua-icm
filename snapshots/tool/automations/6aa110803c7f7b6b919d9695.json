        "code": "// Flatten to the row shape the CSV node reads. A field never set on a record is\n// MISSING, not null, so it is defaulted to '' - otherwise the column holds \"null\".\ndef out = []\ndef v = { m, k -> (m != null && m[k] != null) ? m[k].toString() : '' }\nif (rows != null) rows.each { r ->\n    def p = r.properties\n    out << [titleCode: v(p, 'titleCode'), name: v(p, 'name'), description: v(p, 'description'),\n            category: v(p, 'category'), level: v(p, 'level'), market: v(p, 'market'),\n            function: v(p, 'function'), payPeriod: v(p, 'payPeriod')]\n}\n\n// `total` is the server's count of everything matching the filter (includeTotalCount\n// is on), and it is NOT capped by the fetch limit - so comparing it with what came\n// back is what makes a short file impossible to miss. The status is computed HERE\n// rather than being a literal on the STOP node, because only this node can know.\nint n = out.size()\nint tot = (total == null) ? n : (total as int)\nboolean truncated = tot > n\n\nreturn [titles: out, total: n, matched: tot, truncated: truncated,\n        status: truncated ? 'TRUNCATED' : 'OK',\n        message: truncated\n            ? ('Incomplete file: ' + n + ' of ' + tot + ' titles. Raise maxRows to export the rest.')\n            : (n == 0 ? 'No titles found; the file has its header row only.'\n                      : ('All ' + n + ' title(s) exported.'))]\n",
        "compile_static": false,
