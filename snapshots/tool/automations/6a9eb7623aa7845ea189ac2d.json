        "compile_static": false,
        "code": "\ndef opt = { String k -> if (!binding.hasVariable(k)) return ''\n                        def v = binding.getVariable(k); return (v == null) ? '' : v.toString().trim() }\n// conditions and result arrive as a real List and a real Map. Reading them with\n// opt() would stringify them, and a Java map's toString is not JSON - that is\n// exactly what made the old resultsJson round trip necessary.\ndef raw = { String k -> binding.hasVariable(k) ? binding.getVariable(k) : null }\n\ndef nm = opt('name'); def rt = opt('ruleType')\ndef desc = opt('description'); def tg = opt('tags')\ndef extra = opt('rollableOnReporting')\ndef condIn = raw('conditions'); def resIn = raw('result')\n\nboolean valid = true; String reason = ''\nif (nm.isEmpty()) { valid = false; reason = 'name is required' }\nelse if (rt.isEmpty()) { valid = false; reason = 'ruleType is required' }\n\ndef conds = (condIn instanceof List) ? condIn : []\nif (condIn != null && !(condIn instanceof List)) { valid = false; reason = 'conditions must be a list' }\n\n// ONE result per rule. A rule that produces nothing would match deals and change\n// no numbers, which is a rule nobody can see the effect of.\ndef res = null\nif (resIn == null) { valid = false; reason = 'result is required' }\nelse if (!(resIn instanceof Map)) { valid = false; reason = 'result must be an object' }\nelse {\n    res = resIn\n    def rn = res.get('name')\n    if (rn == null || rn.toString().trim().isEmpty()) { valid = false; reason = 'the result needs a name' }\n}\n\ndef parseDate = { String s ->\n    if (s == null || s.trim().isEmpty()) return null\n    def t = s.trim()\n    if (t ==~ /^\\d+$/) return Long.valueOf(t)\n    try { return java.time.LocalDate.parse(t).toEpochDay() * 86400000L }\n    catch (Exception e) { valid = false; reason = 'not a date: ' + t; return null }\n}\ndef sEp = parseDate(opt('activeStart'))\ndef eEp = parseDate(opt('activeEnd'))\nif (sEp != null && eEp != null && eEp < sEp) { valid = false; reason = 'activeEnd is before activeStart' }\n\n// The id is MINTED here, not asked for: the form has no field for it and a\n// human-picked key on a rule buys nothing, unlike a position code.\ndef rid = 'CR-' + System.currentTimeMillis() + '-' + new Random().nextInt(9000).plus(1000)\n\n// conditions stays wrapped under 'items' because it IS a list and a bare array is\n// dropped on write. result is a single object, so it is stored as itself.\nreturn [valid: valid, reason: reason, ruleId: rid, nm: nm, rt: rt, desc: desc, tg: tg, extra: extra,\n        activeStart: sEp, activeEnd: eEp,\n        conditions: [items: conds], result: res,\n        conditionCount: conds.size(),\n        dupFilter: [operator:'AND', filters:[[property:'properties.ruleId', filter:[operator:'EQUAL', value: rid]]]]]\n",
        "captureStdOutput": false,
