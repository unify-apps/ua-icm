        "compile_static": false,
        "code": "\ndef opt = { String k -> if (!binding.hasVariable(k)) return ''\n                        def v = binding.getVariable(k); return (v == null) ? '' : v.toString().trim() }\ndef s = opt('search'); def fMode = opt('mode'); def fTier = opt('tiering')\ndef lim = opt('limit'); def off = opt('offset')\n\nboolean valid = true; String reason = ''\nint pageLimit = 50\nif (!lim.isEmpty()) { if (lim ==~ /^\\d+$/) pageLimit = Integer.parseInt(lim) else { valid=false; reason='limit must be a whole number, got: ' + lim } }\nif (pageLimit < 1) pageLimit = 1\nif (pageLimit > 200) pageLimit = 200\nint pageOffset = 0\nif (!off.isEmpty()) { if (off ==~ /^\\d+$/) pageOffset = Integer.parseInt(off) else { valid=false; reason='offset must be a whole number, got: ' + off } }\n\n// A rate table has no stage and no active window, so unlike the rule lists there is\n// no identity filter here - an empty filter set legitimately means 'all of them'.\ndef leaves = []\nif (!s.isEmpty()) leaves << [operator:'OR', filters:[\n    [property:'properties.name',        filter:[operator:'ICONTAINS', value:s]],\n    [property:'properties.rateTableId', filter:[operator:'ICONTAINS', value:s]]]]\nif (!fMode.isEmpty()) leaves << [property:'properties.mode',    filter:[operator:'EQUAL', value:fMode]]\nif (!fTier.isEmpty()) leaves << [property:'properties.tiering', filter:[operator:'EQUAL', value:fTier]]\nif (!valid) leaves = [[property:'id', filter:[operator:'EQUAL', value:'__invalid_input__']]]\nreturn [valid: valid, reason: reason, filter: [operator:'AND', filters: leaves],\n        pageLimit: pageLimit, pageOffset: pageOffset]\n",
        "captureStdOutput": false,
