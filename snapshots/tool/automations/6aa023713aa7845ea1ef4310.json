        "code": "\n// A missing ruleId and a ruleId that matches nothing are DIFFERENT answers. Both\n// return no rows, so the status has to be decided here where validity is known -\n// otherwise a caller that forgot the id is told the rule does not exist.\nboolean ok = (wasValid == null) ? true : Boolean.valueOf(String.valueOf(wasValid))\ndef r = (rows == null || rows.isEmpty()) ? null : rows[0]\nif (!ok) return [status: 'INVALID_INPUT', found: false, rule: null, message: String.valueOf(reason)]\nif (r == null) return [status: 'NOT_FOUND', found: false, rule: null, message: 'no rule with that id']\ndef p = r.properties\n// conditions is a list under items; result is a single object stored as itself.\ndef cs = (p?.conditions instanceof Map) ? (p.conditions.get('items') ?: []) : []\ndef res = (p?.result instanceof Map) ? p.result : null\ndef rule = [ruleId: p?.ruleId ?: '', recordId: String.valueOf(r.id),\n            name: p?.name ?: '', ruleType: p?.ruleType ?: '',\n            description: p?.description ?: '', stage: p?.stage ?: '',\n            activeStart: p?.activeStart, activeEnd: p?.activeEnd,\n            tags: p?.tags ?: '', conditions: cs, result: res,\n            conditionCount: cs.size()]\nreturn [status: 'OK', found: true, rule: rule, message: 'rule ' + rule.ruleId]\n",
