        "code": "\ndef out = []\nif (rows != null) rows.each { r ->\n    def p = r.properties\n    out << [payeeId: String.valueOf(r.id),\n            employeeId: p?.employeeId ?: '',\n            name: p?.name ?: '',\n            email: p?.email ?: '',\n            status: p?.status ?: '']\n}\nint tot = (total == null) ? out.size() : Integer.valueOf(String.valueOf(total))\nreturn [payees: out, total: tot, hasMore: (pageOffset + out.size()) < tot,\n        message: out.size() + ' payee(s) on this page']",
