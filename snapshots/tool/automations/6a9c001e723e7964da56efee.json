        "compile_static": false,
        "code": "\n// Same shape as ICM | List Positions: \"\" is what real callers send, so every\n// default is applied here rather than assumed.\ndef t = { v -> v == null ? '' : v.toString().trim() }\ndef s = t(search); def lim = t(limit); def off = t(offset); def act = t(activeOnly)\n\nboolean valid = true; String reason = ''\nint pageLimit = 50\nif (!lim.isEmpty()) { if (lim ==~ /^\\d+$/) { pageLimit = Integer.parseInt(lim) } else { valid=false; reason='limit must be a whole number, got: ' + lim } }\nif (pageLimit < 1) pageLimit = 1\nif (pageLimit > 200) pageLimit = 200\nint pageOffset = 0\nif (!off.isEmpty()) { if (off ==~ /^\\d+$/) { pageOffset = Integer.parseInt(off) } else { valid=false; reason='offset must be a whole number, got: ' + off } }\n\n// search narrows SERVER-side across the two things a human types: the name and\n// the employee id. ICONTAINS so case never matters.\ndef leaves = []\nif (!s.isEmpty()) leaves << [operator:'OR', filters:[\n   [property:'properties.name',       filter:[operator:'ICONTAINS', value:s]],\n   [property:'properties.employeeId', filter:[operator:'ICONTAINS', value:s]]]]\n// a payee who has left should not be offered as the occupant of a NEW seat\nif (act.equalsIgnoreCase('true')) leaves << [property:'properties.status', filter:[operator:'NOT_EQUAL', value:'TERMINATED']]\ndef filter = leaves.isEmpty() ? [:] : [operator:'AND', filters: leaves]\nreturn [valid: valid, reason: reason, filter: filter, pageLimit: pageLimit, pageOffset: pageOffset]",
        "captureStdOutput": false,
        "parameters": {
