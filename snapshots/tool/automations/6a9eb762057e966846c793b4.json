        "compile_static": false,
        "code": "\n// conditions is a list and stays wrapped under 'items'; result is a single object\n// stored as itself. The row carries the result's NAME rather than a count of one.\ndef out = []\nif (rows != null) rows.each { r ->\n    def p = r.properties\n    def cs = (p?.conditions instanceof Map) ? (p.conditions.get('items') ?: []) : []\n    def res = (p?.result instanceof Map) ? p.result : null\n    out << [ruleId: p?.ruleId ?: '', recordId: String.valueOf(r.id),\n            name: p?.name ?: '', ruleType: p?.ruleType ?: '',\n            description: p?.description ?: '', stage: p?.stage ?: '',\n            activeStart: p?.activeStart, activeEnd: p?.activeEnd,\n            tags: p?.tags ?: '', conditionCount: cs.size(),\n            resultName: (res == null) ? '' : (res.get('name') ?: '')]\n}\nint tot = (total == null) ? out.size() : Integer.valueOf(String.valueOf(total))\nreturn [rules: out, total: tot, hasMore: (pageOffset + out.size()) < tot,\n        message: out.size() + ' credit rule' + (out.size() == 1 ? '' : 's') + ' on this page']\n",
