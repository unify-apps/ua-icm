        "compile_static": false,
        "code": "\ndef opt = { String k -> if (!binding.hasVariable(k)) return ''\n                        def v = binding.getVariable(k); return (v == null) ? '' : v.toString().trim() }\ndef s = opt('search'); def fName = opt('name'); def fType = opt('ruleType')\ndef lim = opt('limit'); def off = opt('offset')\n\nboolean valid = true; String reason = ''\nint pageLimit = 50\nif (!lim.isEmpty()) { if (lim ==~ /^\\d+$/) pageLimit = Integer.parseInt(lim) else { valid=false; reason='limit must be a whole number, got: ' + lim } }\nif (pageLimit < 1) pageLimit = 1\nif (pageLimit > 200) pageLimit = 200\nint pageOffset = 0\nif (!off.isEmpty()) { if (off ==~ /^\\d+$/) pageOffset = Integer.parseInt(off) else { valid=false; reason='offset must be a whole number, got: ' + off } }\n\n// The stage is this callable's IDENTITY, not a caller's choice: a payout rule\n// must never surface in the credit list however the caller filters.\ndef leaves = [[property:'properties.stage', filter:[operator:'EQUAL', value:'credit']]]\nif (!s.isEmpty()) leaves << [operator:'OR', filters:[\n    [property:'properties.name',   filter:[operator:'ICONTAINS', value:s]],\n    [property:'properties.ruleId', filter:[operator:'ICONTAINS', value:s]]]]\nif (!fName.isEmpty()) leaves << [property:'properties.name',     filter:[operator:'ICONTAINS', value:fName]]\nif (!fType.isEmpty()) leaves << [property:'properties.ruleType', filter:[operator:'EQUAL',     value:fType]]\nif (!valid) leaves = [[property:'id', filter:[operator:'EQUAL', value:'__invalid_input__']]]\nreturn [valid: valid, reason: reason, filter: [operator:'AND', filters: leaves],\n        pageLimit: pageLimit, pageOffset: pageOffset]",
        "captureStdOutput": false,
