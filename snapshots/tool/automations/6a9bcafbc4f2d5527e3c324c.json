        "code": "// Close the window in memory: missing, null and blank effectiveEnd all mean\n// \"still held\" - the platform stores an unset property as ABSENT, so all three\n// are checked rather than assumed equivalent.\ndef live = []\ndef ids = []\nlong asOf = Long.valueOf(String.valueOf(asOfEpoch))\nif (rows != null) {\n    rows.each { r ->\n        def p = r.properties\n        def en = p?.effectiveEnd\n        boolean open = (en == null) || en.toString().trim().isEmpty()\n        if (open || (Long.valueOf(String.valueOf(en)) >= asOf)) {\n            def pid = (p?.payeeId == null) ? '' : p.payeeId.toString().trim()\n            live << [positionId: String.valueOf(p?.positionId), payeeId: pid]\n            if (!pid.isEmpty() && !ids.contains(pid)) ids << pid\n        }\n    }\n}\nreturn [live: live, payeeIds: ids.isEmpty() ? ['__none__'] : ids]",
        "compile_static": false,
        "captureStdOutput": false,
