            "wantOccupancy": {
              "type": "boolean",
              "title": "Want Occupancy"
            },
            "asOfDay": {
              "type": "string",
              "title": "As Of Day"
            },
            "pageOffset": {
              "type": "integer",
              "title": "Page Offset"
            }
