        "code": "// Every default is applied HERE, never assumed from the caller. Real callers\n// send \"\" for what they did not fill, so \"\" is the value each branch is built\n// around rather than an edge case.\ndef s   = (search == null) ? '' : search.toString().trim()\ndef raw = (asOfDate == null) ? '' : asOfDate.toString().trim()\ndef lim = (limit == null) ? '' : limit.toString().trim()\ndef off = (offset == null) ? '' : offset.toString().trim()\ndef occ = (includeOccupancy == null) ? '' : includeOccupancy.toString().trim()\n\nboolean valid = true\nString reason = ''\nlong epoch = 0L\nString day = ''\n\nif (raw.isEmpty()) {\n    // default: TODAY, UTC - and it is echoed back so a caller in another\n    // timezone always knows which day it actually got\n    def d = java.time.LocalDate.now(java.time.ZoneOffset.UTC)\n    epoch = d.atStartOfDay(java.time.ZoneOffset.UTC).toInstant().toEpochMilli()\n    day = d.toString()\n} else if (raw ==~ /^\\d{4}-\\d{2}-\\d{2}$/) {\n    try {\n        def d = java.time.LocalDate.parse(raw)\n        epoch = d.atStartOfDay(java.time.ZoneOffset.UTC).toInstant().toEpochMilli()\n        day = raw\n    } catch (Exception e) { valid = false; reason = 'asOfDate is not a real calendar date: ' + raw }\n} else if (raw ==~ /^\\d{9,}$/) {\n    epoch = Long.parseLong(raw)\n    day = java.time.Instant.ofEpochMilli(epoch).atZone(java.time.ZoneOffset.UTC).toLocalDate().toString()\n} else {\n    valid = false; reason = 'asOfDate must be YYYY-MM-DD or epoch milliseconds, got: ' + raw\n}\n\nint pageLimit = 50\nif (!lim.isEmpty()) {\n    if (lim ==~ /^\\d+$/) { pageLimit = Integer.parseInt(lim) } else { valid = false; reason = 'limit must be a whole number, got: ' + lim }\n}\nif (pageLimit < 1) pageLimit = 1\nif (pageLimit > 200) pageLimit = 200\n\nint pageOffset = 0\nif (!off.isEmpty()) {\n    if (off ==~ /^\\d+$/) { pageOffset = Integer.parseInt(off) } else { valid = false; reason = 'offset must be a whole number, got: ' + off }\n}\n\nboolean wantOcc = occ.isEmpty() ? true : !(occ.equalsIgnoreCase('false'))\n\n// A nested OR group inside the AND. A filter node's STATIC config cannot\n// express this, but the runtime accepts the whole object built here and passed\n// as one pill (runtime-facts, proven 2026-08-24). Filtering after the fetch\n// instead would break `total` and paging.\ndef filters = []\nif (!valid) {\n    filters << [property: 'id', filter: [operator: 'EQUAL', value: '__invalid_input__']]\n} else if (!s.isEmpty()) {\n    filters << [operator: 'OR', filters: [\n        [property: 'properties.positionCode', filter: [operator: 'ICONTAINS', value: s]],\n        [property: 'properties.name',         filter: [operator: 'ICONTAINS', value: s]]]]\n}\nreturn [valid: valid, reason: reason, asOfEpoch: epoch, asOfDay: day,\n        pageLimit: pageLimit, pageOffset: pageOffset, wantOccupancy: wantOcc,\n        filter: [operator: 'AND', filters: filters]]",
        "compile_static": false,
        "captureStdOutput": false,
