        "code": "// The same as-of rule as ICM | Resolve Position Occupant, folded in memory for a\n// whole page at once. Two assignments covering the date is a CONFLICT and never\n// a pick - a position has one occupant on a day, and guessing would pay somebody\n// wrongly.\ndef byPos = [:]\nif (live != null) live.each { l ->\n    def k = String.valueOf(l.positionId)\n    if (!byPos.containsKey(k)) byPos[k] = []\n    byPos[k] << l\n}\n// The SAME as-of window rule the assignments get: a position's title is effective-dated\n// too, and an attribute row that ended before the date describes a position that has\n// since been re-titled. Absent/blank effectiveEnd means still in force.\ndef titleById = [:]\nif (titleRows != null) titleRows.each { t -> titleById[String.valueOf(t.id)] = t.properties?.name ?: '' }\ndef attrByPos = [:]\nlong asOfMs = Long.valueOf(String.valueOf(asOfEpoch))\nif (attrRows != null) attrRows.each { a ->\n    def ap = a.properties\n    def st = ap?.effectiveStart\n    def en = ap?.effectiveEnd\n    boolean started = (st == null) || (Long.valueOf(String.valueOf(st)) <= asOfMs)\n    boolean open = (en == null) || en.toString().trim().isEmpty()\n    if (started && (open || Long.valueOf(String.valueOf(en)) >= asOfMs)) {\n        def k = String.valueOf(ap?.positionId)\n        // several in force is a data problem, not a pick - keep the first and say nothing\n        if (!attrByPos.containsKey(k)) attrByPos[k] = ap\n    }\n}\n\ndef payById = [:]\nif (payRows != null) payRows.each { p -> payById[String.valueOf(p.id)] = p.properties }\n\nint occupied = 0, vacant = 0, conflict = 0\ndef positions = []\nif (posRows != null) posRows.each { r ->\n    def p = r.properties\n    def position = [positionId: String.valueOf(r.id),\n                positionCode: p?.positionCode ?: '',\n                name: p?.name ?: '',\n                // a boolean never set is MISSING, not false - treat absent as active\n                active: (p?.active == null) ? true : (p.active as boolean),\n                occupancy: 'UNKNOWN', payeeId: '', employeeId: '', payeeName: '', matchCount: 0,\n                // null unless ONE assignment resolved this row - a VACANT row has none and a\n                // CONFLICT row has several, and naming one would be the guess we refuse to make\n                effectiveStart: null, effectiveEnd: null, allocationPct: null,\n                // the position's own effective-dated attributes, independent of who holds it\n                titleName: '', attributeEffectiveStart: null]\n    def attr = attrByPos[String.valueOf(r.id)]\n    if (attr != null) {\n        position.titleName = titleById[String.valueOf(attr.titleId)] ?: ''\n        position.attributeEffectiveStart = (attr.effectiveStart == null) ? null : Long.valueOf(String.valueOf(attr.effectiveStart))\n    }\n    if (wantOccupancy) {\n        def hits = byPos[String.valueOf(r.id)] ?: []\n        position.matchCount = hits.size()\n        if (hits.size() == 0)      { position.occupancy = 'VACANT';   vacant++ }\n        else if (hits.size() > 1)  { position.occupancy = 'CONFLICT'; conflict++ }\n        else {\n            position.occupancy = 'OCCUPIED'; occupied++\n            position.payeeId = String.valueOf(hits[0].payeeId)\n            def pay = payById[position.payeeId]\n            position.employeeId = (pay == null) ? '' : (pay.employeeId ?: '')\n            position.payeeName  = (pay == null) ? '' : (pay.name ?: '')\n            position.effectiveStart = hits[0].effectiveStart\n            // null here means OPEN-ENDED, still held - not \"unknown\"\n            position.effectiveEnd   = hits[0].effectiveEnd\n            position.allocationPct  = hits[0].allocationPct\n        }\n    }\n    positions << position\n}\n\n// Post-filters apply to what the fold PRODUCED, so they run here and the page is\n// cut afterwards - otherwise `total` and hasMore would describe the unfiltered set.\nboolean truncated = false\nif (postFilter) {\n    def keep = positions.findAll { p ->\n        boolean okOcc = fOcc == null || fOcc.toString().isEmpty() || p.occupancy == fOcc\n        boolean okPer = fPerson == null || fPerson.toString().isEmpty() ||\n                        (p.payeeName != null && p.payeeName.toLowerCase().contains(fPerson.toString().toLowerCase()))\n        okOcc && okPer\n    }\n    truncated = positions.size() >= Integer.valueOf(String.valueOf(scanCap))\n    occupied = keep.count { it.occupancy == 'OCCUPIED' }\n    vacant   = keep.count { it.occupancy == 'VACANT' }\n    conflict = keep.count { it.occupancy == 'CONFLICT' }\n    int from = Math.min(pageOffset, keep.size())\n    int to   = Math.min(from + Integer.valueOf(String.valueOf(pageLimit)), keep.size())\n    positions = keep.subList(from, to)\n    posTotal = keep.size()\n}\n\nint total = (posTotal == null) ? positions.size() : Integer.valueOf(String.valueOf(posTotal))\nint got   = (asgRows == null) ? 0 : asgRows.size()\nint asgTot = (asgTotal == null) ? got : Integer.valueOf(String.valueOf(asgTotal))\n\nreturn [positions: positions,\n        truncated: truncated,\n        total: total,\n        hasMore: (pageOffset + positions.size()) < total,\n        counts: [total: positions.size(), occupied: occupied, vacant: vacant, conflict: conflict],\n        countsTruncated: got < asgTot,\n        message: wantOccupancy\n            ? (positions.size() + ' position(s) on this page, as of ' + String.valueOf(asOfDay))\n            : (positions.size() + ' position(s) on this page; occupancy not resolved')]",
