        "compile_static": false,
        "code": "\ndef opt = { String k -> if (!binding.hasVariable(k)) return ''\n                        def v = binding.getVariable(k); return (v == null) ? '' : v.toString().trim() }\ndef pid = opt('planId')\nboolean valid = !pid.isEmpty()\nString reason = valid ? '' : 'planId is required'\n// A blank id must not fall through to an unfiltered fetch that returns whatever is\n// first - that would show one plan while claiming to be another.\ndef leaves = valid ? [[property:'properties.planId', filter:[operator:'EQUAL', value: pid]]]\n                   : [[property:'id', filter:[operator:'EQUAL', value:'__invalid_input__']]]\nreturn [valid: valid, reason: reason, planId: pid,\n        filter: [operator:'AND', filters: leaves], pageLimit: 1, pageOffset: 0,\n        asgFilter: [operator:'AND', filters: [[property:'properties.planId', filter:[operator:'EQUAL', value: (valid ? pid : '__invalid_input__')]]]]]\n",
