        "compile_static": false,
        "code": "\n// A missing planId and a planId that matches nothing are DIFFERENT answers. Both\n// return no rows, so validity has to be read here rather than inferred from emptiness.\nboolean ok = (wasValid == null) ? true : Boolean.valueOf(String.valueOf(wasValid))\ndef r = (rows == null || rows.isEmpty()) ? null : rows[0]\nif (!ok) return [status:'INVALID_INPUT', found:false, plan:null, message:String.valueOf(reason)]\nif (r == null) return [status:'NOT_FOUND', found:false, plan:null, message:'no plan with that id']\ndef p = r.properties\ndef cr = (p?.creditRuleIds instanceof Map) ? (p.creditRuleIds.get('items') ?: []) : []\ndef pr = (p?.payoutRuleIds instanceof Map) ? (p.payoutRuleIds.get('items') ?: []) : []\n\n// One PlanAssignment row per title or position, split back into the two lists the\n// form edits. targetType is what separates them; nothing else does.\ndef titles = []; def positions = []\nif (asgRows != null) asgRows.each { a ->\n    def ap = a.properties\n    def row = [assignmentId: ap?.assignmentId ?: '', recordId: String.valueOf(a.id),\n               targetId: ap?.targetId ?: '', effectiveStart: ap?.startDate, effectiveEnd: ap?.endDate]\n    def t = String.valueOf(ap?.targetType ?: '').toUpperCase()\n    if (t == 'TITLE') titles << row else if (t == 'POSITION') positions << row\n}\ndef plan = [planId: p?.planId ?: '', recordId: String.valueOf(r.id),\n            name: p?.name ?: '', description: p?.description ?: '',\n            periodId: p?.periodId ?: '', status: p?.status ?: '',\n            version: p?.version, startDate: p?.startDate, endDate: p?.endDate,\n            creditRuleIds: cr, payoutRuleIds: pr,\n            assignments: [titles: titles, positions: positions]]\nreturn [status:'OK', found:true, plan: plan, message:'plan ' + plan.planId]\n",
