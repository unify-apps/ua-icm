        "code": "// The timezone rule lives HERE and nowhere else: a bare YYYY-MM-DD means\n// midnight UTC on that day. \"2026-03-31\" resolving to a different instant in\n// two timezones would move a deal between quarters, so it is decided once.\ndef pid = (positionId == null) ? '' : positionId.toString().trim()\ndef raw = (asOfDate == null) ? '' : asOfDate.toString().trim()\nlong epoch = 0L\nString day = ''\nboolean valid = false\nString reason = ''\nif (pid.isEmpty()) {\n    reason = 'positionId is required'\n} else if (raw.isEmpty()) {\n    reason = 'asOfDate is required'\n} else if (raw ==~ /^\\d{4}-\\d{2}-\\d{2}$/) {\n    try {\n        def d = java.time.LocalDate.parse(raw)\n        epoch = d.atStartOfDay(java.time.ZoneOffset.UTC).toInstant().toEpochMilli()\n        day = raw\n        valid = true\n    } catch (Exception e) {\n        reason = 'asOfDate is not a real calendar date: ' + raw\n    }\n} else if (raw ==~ /^\\d{9,}$/) {\n    epoch = Long.parseLong(raw)\n    day = java.time.Instant.ofEpochMilli(epoch).atZone(java.time.ZoneOffset.UTC).toLocalDate().toString()\n    valid = true\n} else {\n    reason = 'asOfDate must be YYYY-MM-DD or epoch milliseconds, got: ' + raw\n}\nreturn [positionId: pid, asOfEpoch: epoch, asOfDay: day, valid: valid, reason: reason]",
        "compile_static": false,
        "captureStdOutput": false,
        "parameters": {
          "positionId": "{{ n_sTaRt.outputs.positionId }}",
          "asOfDate": "{{ n_sTaRt.outputs.asOfDate }}"
        }
