        "code": "// Closes the window: an assignment covers asOf when it had started AND has\n// either not ended or ends on/after asOf. Missing, null and blank effectiveEnd\n// all mean \"still held\" - the platform stores an unset property as ABSENT, not\n// as an empty value, so all three are checked rather than assumed equivalent.\ndef matches = []\ndef ids = []\nlong asOf = Long.valueOf(String.valueOf(asOfEpoch))\nif (valid && rows != null) {\n    rows.each { r ->\n        def p = r.properties\n        def en = p?.effectiveEnd\n        boolean open = (en == null) || en.toString().trim().isEmpty()\n        boolean endOk = open || (Long.valueOf(String.valueOf(en)) >= asOf)\n        if (endOk) {\n            def pid = (p?.payeeId == null) ? '' : p.payeeId.toString().trim()\n            matches << [id: String.valueOf(r.id),\n                        payeeId: pid,\n                        startEpoch: (p?.effectiveStart == null) ? 0L : Long.valueOf(String.valueOf(p.effectiveStart)),\n                        endEpoch: open ? -1L : Long.valueOf(String.valueOf(en)),\n                        allocationPct: (p?.allocationPct == null) ? 0 : p.allocationPct]\n            if (!pid.isEmpty() && !ids.contains(pid)) ids << pid\n        }\n    }\n}\n// The '__none__' sentinel keeps the Payee fetch a clean no-op instead of an\n// unfiltered scan when nobody held the seat.\nreturn [matches: matches, payeeIds: ids.isEmpty() ? ['__none__'] : ids]",
        "compile_static": false,
        "captureStdOutput": false,
        "parameters": {
          "rows": "{{ n_FtAsg.outputs.objects }}",
          "asOfEpoch": "{{ n_Norm.outputs.result.asOfEpoch }}",
          "valid": "{{ n_Norm.outputs.result.valid }}"
        }
