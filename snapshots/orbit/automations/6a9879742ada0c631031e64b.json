        "code": "// One node owns the whole outcome so the as-of rule has exactly one home.\ndef fmt = { long ms -> java.time.Instant.ofEpochMilli(ms).atZone(java.time.ZoneOffset.UTC).toLocalDate().toString() }\ndef ms = (matches == null) ? [] : matches\ndef r = [outcome: '', message: '', positionCode: '', positionName: '',\n         payeeId: '', employeeId: '', payeeName: '', payeeCurrency: '',\n         effectiveStart: '', effectiveEnd: '', allocationPct: 0, matchCount: ms.size()]\n\nif (!valid) { r.outcome = 'INVALID_INPUT'; r.message = reason; return r }\n\nif (posRows == null || posRows.isEmpty()) {\n    r.outcome = 'POSITION_NOT_FOUND'\n    r.message = 'No position with id ' + String.valueOf(positionId)\n    return r\n}\nr.positionCode = posRows[0].properties?.positionCode ?: ''\nr.positionName = posRows[0].properties?.name ?: ''\n\n// A bulk fetch that hit its limit lies by omission. Say so rather than answer\n// confidently from a partial set.\nint got = (asgRows == null) ? 0 : asgRows.size()\nint total = (asgTotal == null) ? got : Integer.valueOf(String.valueOf(asgTotal))\nif (got < total) {\n    r.outcome = 'AMBIGUOUS'\n    r.message = 'Seat ' + r.positionCode + ' has ' + total + ' assignment rows but only ' + got +\n                ' were read - refusing to answer from a truncated set'\n    return r\n}\n\nif (ms.isEmpty()) {\n    r.outcome = 'VACANT'\n    r.message = 'Seat ' + r.positionCode + ' was unoccupied on ' + String.valueOf(asOfDay)\n    return r\n}\nif (ms.size() > 1) {\n    r.outcome = 'AMBIGUOUS'\n    r.message = ms.size() + ' overlapping assignments cover ' + String.valueOf(asOfDay) +\n                ' on seat ' + r.positionCode + ' - this is an assignment data bug, not a tie to break'\n    return r\n}\n\ndef m = ms[0]\nr.payeeId = String.valueOf(m.payeeId)\nr.effectiveStart = fmt(Long.valueOf(String.valueOf(m.startEpoch)))\nlong en = Long.valueOf(String.valueOf(m.endEpoch))\nr.effectiveEnd = (en < 0) ? '' : fmt(en)\nr.allocationPct = m.allocationPct\n\ndef pay = (payRows == null) ? null : payRows.find { String.valueOf(it.id) == r.payeeId }\nif (pay == null) {\n    r.outcome = 'PAYEE_NOT_FOUND'\n    r.message = 'Assignment points at payee ' + r.payeeId + ', which does not exist. ' +\n                'Foreign keys are not enforced on PayeePositionAssignment.'\n    return r\n}\nr.employeeId = pay.properties?.employeeId ?: ''\nr.payeeName  = pay.properties?.name ?: ''\n// Resolve the currency LOOKUP to its printable code. A missing currency row is\n// left blank rather than guessed: showing an amount against the wrong currency\n// is worse than showing it against none.\ndef curId = pay.properties?.currencyId\ndef cur = (curRows == null || curId == null) ? null : curRows.find { String.valueOf(it.id) == String.valueOf(curId) }\nr.payeeCurrency = (cur == null) ? '' : (cur.properties?.code ?: '')\nr.payeeCurrencySymbol = (cur == null) ? '' : (cur.properties?.symbol ?: '')\nr.outcome = 'RESOLVED'\nr.message = 'Seat ' + r.positionCode + ' was held by ' + r.payeeName + ' on ' + String.valueOf(asOfDay)\nreturn r",
